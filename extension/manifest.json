{
  "manifest_version": 3,
  "name": "iWork 证据采集",
  "description": "从当前问题页面采集原始证据，在本机整理报告并记录采集缺口。",
  "version": "0.1.15",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging", "downloads", "alarms"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_title": "采集当前 Bug", "default_popup": "popup.html"},
  "options_page": "options.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
